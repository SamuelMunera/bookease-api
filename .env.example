# Supabase — pooler (Prisma queries, puerto 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase — direct (migraciones Prisma, puerto 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase — Storage (necesario para subir portadas, logos y galería)
# Obtener en: Dashboard → Settings → API
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_KEY="eyJ..."

JWT_SECRET="change_this_secret_in_production"
JWT_EXPIRES_IN="7d"
PORT=3000
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Slotly <noreply@tudominio.com>"
APP_URL="https://tudominio.com"

CRON_SECRET="change_this_cron_secret"

# Mapbox — geocodificación de direcciones de negocios (Geocoding API v6).
# Obtener en: https://account.mapbox.com/access-tokens/ (token público pk.*)
# Si falta, se usa Nominatim (OpenStreetMap) como fallback menos preciso.
MAPBOX_TOKEN="pk.xxxxxxxxxxxxxxxxxxxx"

# Wompi — SANDBOX/TEST ONLY. WOMPI_ENV debe ser "test"; el servidor se niega a iniciar
# si falta alguna variable o si una llave no tiene el prefijo de sandbox (pub_test_/prv_test_/test_events_/test_integrity_).
# Obtener en: Wompi Dashboard (sandbox) → Desarrolladores
WOMPI_ENV="test"
WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_PRIVATE_KEY="prv_test_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_EVENTS_KEY="test_events_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_INTEGRITY_KEY="test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx"
