generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  BUSINESS_OWNER
  PROFESSIONAL
  ADMIN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BusinessStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  googleId  String?  @unique
  role      Role     @default(CLIENT)
  country   String   @default("CO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses          Business[]
  bookings            Booking[]
  professional        Professional?
  passwordResetTokens PasswordResetToken[]
  reviews             Review[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id          String           @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  phone       String?
  category    String
  ownerId     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  logoUrl            String?
  coverUrl           String?
  accentColor        String?
  joinCode           String?  @unique
  showRevenueToProf  Boolean  @default(false)
  cancelMinHours     Int      @default(0)
  country            String   @default("CO")
  timezone           String   @default("America/Bogota")
  state              String?
  zipCode            String?
  lat                Float?
  lng                Float?
  status             BusinessStatus @default(ACTIVE)
  emailVerified      Boolean   @default(false)
  plan               String   @default("team")
  paymentGateway     String?
  stripeCustomerId   String?
  coveredByCourtesy  Boolean  @default(false)
  emailVerifyToken   String?   @unique
  emailVerifyExpiry  DateTime?
  nameNorm           String?
  phoneNorm          String?
  addressNorm        String?
  promoterId         String?

  // Business-to-business referral program
  themeLight            Json?
  themeDark             Json?
  apptVerifyEnabled     Boolean  @default(false)
  apptVerifyHoursBefore Int      @default(2)
  reviewsPublic         Boolean  @default(true)

  referralCode          String?  @unique   // código propio para referir otros negocios
  referredByCode        String?            // código que usó al registrarse (si aplica)
  referrerBusinessId    String?            // negocio que lo refirió (resuelto)
  freeMonthsEarned      Int      @default(0)
  freeMonthsUsed        Int      @default(0)
  discountCreditsEarned Int      @default(0)
  discountCreditsUsed   Int      @default(0)

  owner             User              @relation(fields: [ownerId], references: [id])
  professionals     Professional[]
  services          Service[]
  serviceCategories ServiceCategory[]
  gallery           BusinessGallery[]
  hours             BusinessHours[]
  joinRequests      JoinRequest[]
  reviews           Review[]
  subscription      Subscription?
  promoter          Promoter?     @relation("PromoterBusinesses", fields: [promoterId], references: [id])
  redeemedCourtesy  CourtesyCode?
  payments          Payment[]
  promoterConversion PromoterConversion?
  promotions        Promotion[]

  referrer           Business?  @relation("BizReferral", fields: [referrerBusinessId], references: [id])
  referredBusinesses Business[] @relation("BizReferral")
  referralsMade      BusinessReferral[] @relation("Referrer")
  referralRecord     BusinessReferral?  @relation("Referred")
}

// One row per business-to-business referral. The reward for the referrer is
// granted only when the referred business completes a real first payment
// (status SUCCESSFUL), never just for typing the code.
model BusinessReferral {
  id                      String    @id @default(cuid())
  referrerBusinessId      String
  referredBusinessId      String    @unique   // un negocio solo puede ser referido una vez
  referredByCode          String
  status                  String    @default("PENDING")  // PENDING | SUCCESSFUL
  referredDiscountApplied Boolean   @default(false)      // 20% primer mes ya aplicado al referido
  rewardType              String?   // FREE_MONTH | DISCOUNT_20
  rewardValue             Int?      // 100 (mes gratis) | 20 (descuento)
  rewardAppliedAt         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  referrer Business @relation("Referrer", fields: [referrerBusinessId], references: [id])
  referred Business @relation("Referred", fields: [referredBusinessId], references: [id])

  @@index([referrerBusinessId])
}

model Promotion {
  id            String   @id @default(cuid())
  businessId    String
  title         String
  description   String?
  discountType  String   @default("PERCENTAGE") // PERCENTAGE | FIXED | CUSTOM_PRICE
  discountValue Decimal? @db.Decimal(10, 2)
  customPrice   Decimal? @db.Decimal(10, 2)
  serviceIds    String[]
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Professional {
  id         String   @id @default(cuid())
  name       String
  bio        String?
  phone      String?
  specialty  String?
  experience String?
  avatarUrl  String?
  businessId String?
  userId     String?  @unique
  bufferTime     Int      @default(0)
  cancelMinHours Int      @default(0)
  country        String   @default("CO")
  timezone       String   @default("America/Bogota")
  state          String?
  zipCode        String?
  plan             String   @default("solo")
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  isBookable           Boolean  @default(true)
  offersHomeService    Boolean  @default(false)
  homeServiceArea      String?
  homeServiceSurcharge Decimal? @db.Decimal(10, 2)
  homeServiceNotes     String?
  promoterId           String?

  business           Business?                  @relation(fields: [businessId], references: [id])
  user               User?                      @relation(fields: [userId], references: [id])
  subscription       Subscription?
  schedules          Schedule[]
  homeSchedules      HomeSchedule[]
  scheduleExceptions ScheduleException[]
  scheduleOverrides  ScheduleOverride[]
  bookings           Booking[]
  services           Service[]
  homeServices       HomeService[]
  joinRequests       JoinRequest[]
  serviceConfigs     ProfessionalServiceConfig[]
  photos             ProfessionalPhoto[]
  reviews            Review[]
  promoter           Promoter?     @relation("PromoterProfessionals", fields: [promoterId], references: [id])
  redeemedCourtesy   CourtesyCode?
  payments           Payment[]
  promoterConversion PromoterConversion?
}

model ProfessionalPhoto {
  id             String   @id @default(cuid())
  professionalId String
  url            String
  caption        String?
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model ProfessionalServiceConfig {
  id             String   @id @default(cuid())
  professionalId String
  serviceId      String
  customDuration Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])

  @@unique([professionalId, serviceId])
}

model JoinRequest {
  id             String            @id @default(cuid())
  professionalId String
  businessId     String
  status         JoinRequestStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  professional   Professional      @relation(fields: [professionalId], references: [id])
  business       Business          @relation(fields: [businessId], references: [id])

  @@unique([professionalId, businessId])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int
  price       Decimal  @db.Decimal(10, 2)
  businessId  String
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business         Business                    @relation(fields: [businessId], references: [id])
  category         ServiceCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bookings         Booking[]
  professionals    Professional[]
  serviceConfigs   ProfessionalServiceConfig[]
}

model ServiceCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services Service[]
}

model BusinessGallery {
  id         String   @id @default(cuid())
  businessId String
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// dayOfWeek: 0=Sunday … 6=Saturday
model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isOpen     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

// Weekly recurring availability per professional
// dayOfWeek: 0=Sunday ... 6=Saturday
model Schedule {
  id              String   @id @default(cuid())
  professionalId  String
  dayOfWeek       Int
  startTime       String
  endTime         String
  isActive        Boolean  @default(true)
  scheduleType    String   @default("fulltime")
  secondStartTime String?
  secondEndTime   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id])

  @@unique([professionalId, dayOfWeek])
}

// Per-week overrides for the recurring schedule
model ScheduleOverride {
  id              String   @id @default(cuid())
  professionalId  String
  weekStart       DateTime @db.Date
  dayOfWeek       Int
  startTime       String
  endTime         String
  isActive        Boolean  @default(true)
  scheduleType    String   @default("fulltime")
  secondStartTime String?
  secondEndTime   String?
  createdAt       DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])

  @@unique([professionalId, weekStart, dayOfWeek])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingType {
  BUSINESS
  HOME_SERVICE
}

enum BookingSource {
  ONLINE
  MANUAL
  WHATSAPP
  CALL
  PRESENCIAL
}

// Minimal booking — used by slot engine to exclude occupied time
model Booking {
  id             String        @id @default(cuid())
  professionalId String
  serviceId      String?
  homeServiceId  String?
  clientId       String
  date           DateTime      @db.Date
  startTime      String
  endTime        String
  status         BookingStatus @default(PENDING)
  type           BookingType   @default(BUSINESS)
  source         BookingSource @default(ONLINE)
  clientAddress  String?
  guestName      String?
  verificationSentAt DateTime?
  // Precio realmente reservado (fuente única de verdad). Se calcula en el backend
  // al crear la cita aplicando la promoción vigente; analytics/revenue lo usan en
  // vez de recomputar service.price (que ignora promos). Nullable para citas viejas.
  price          Decimal?      @db.Decimal(10, 2)
  originalPrice  Decimal?      @db.Decimal(10, 2)
  promoId        String?
  promoTitle     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  professional Professional  @relation(fields: [professionalId], references: [id])
  service      Service?       @relation(fields: [serviceId], references: [id])
  homeService  HomeService?   @relation(fields: [homeServiceId], references: [id])
  client       User           @relation(fields: [clientId], references: [id])
}

model HomeService {
  id             String   @id @default(cuid())
  professionalId String
  name           String
  description    String?
  duration       Int
  price          Decimal  @db.Decimal(10, 2)
  surcharge      Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  bookings     Booking[]
}

model HomeSchedule {
  id             String   @id @default(cuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, dayOfWeek])
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model Review {
  id             String   @id @default(cuid())
  rating         Int
  comment        String?
  authorId       String
  businessId     String?
  professionalId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  business     Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([authorId, businessId])
  @@unique([authorId, professionalId])
}

model FeedbackReport {
  id          String   @id @default(cuid())
  type        String
  description String
  page        String?
  userEmail   String?
  createdAt   DateTime @default(now())
}

model Subscription {
  id                    String             @id @default(cuid())
  status                SubscriptionStatus @default(TRIALING)
  plan                  String
  country               String
  paymentGateway        String?
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  activatedAt           DateTime?
  // billingPlan: el plan realmente pagado/activado vía pasarela — null hasta
  // el primer pago APPROVED. `plan` es el plan temporal/seleccionado (Equipo
  // por defecto) y no implica cobro real.
  billingPlan           String?
  // autoRenew solo se activa cuando Wompi devuelve un payment_source_id
  // reutilizable tras un pago APPROVED (tarjeta guardada).
  autoRenew             Boolean            @default(false)
  paymentSourceId       String?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeSubscriptionId String?
  businessId           String?            @unique
  professionalId        String?            @unique
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  business     Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

// Blocks a specific date (full day or time range)
model ScheduleException {
  id             String    @id @default(cuid())
  professionalId String
  date           DateTime  @db.Date
  startTime      String?
  endTime        String?
  reason         String?
  createdAt      DateTime  @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])
}

enum PromoterStatus {
  ACTIVE
  INACTIVE
}

enum CourtesyCodeStatus {
  UNUSED
  USED
}

enum ReferralRedeemerType {
  BUSINESS
  PROFESSIONAL
}

// Referral program: promoters get a personal referral code to share.
model Promoter {
  id        String         @id @default(cuid())
  firstName String
  lastName  String
  email     String         @unique
  phone     String?
  code      String         @unique
  country   String         @default("CO") // CO | US — para diferenciar comisiones por moneda
  status    PromoterStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  businesses    Business[]     @relation("PromoterBusinesses")
  professionals Professional[] @relation("PromoterProfessionals")
  conversions   PromoterConversion[]
}

enum PromoterConversionStatus {
  PENDING_PAYMENT
  DISCOUNT_APPLIED
}

// Logs each time a promoter code is used to register a business or
// professional, so admin can track attribution and the resulting
// first-month discount in real time.
model PromoterConversion {
  id               String                   @id @default(cuid())
  promoterId       String
  promoterCode     String
  usedByType       ReferralRedeemerType
  businessId       String?                  @unique
  professionalId   String?                  @unique
  usedAt           DateTime                 @default(now())
  discountType     String                   @default("PERCENT")
  discountValue    Int                      @default(10)
  discountDuration String                   @default("FIRST_MONTH")
  status           PromoterConversionStatus @default(PENDING_PAYMENT)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  promoter     Promoter      @relation(fields: [promoterId], references: [id])
  business     Business?     @relation(fields: [businessId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
}

// Referral program: single-use courtesy codes generated manually from admin.
// Once redeemed during business/professional registration, becomes USED and
// links to whichever entity redeemed it.
model CourtesyCode {
  id        String             @id @default(cuid())
  code      String             @unique
  // Referencia interna para el admin (ej. "Cortesía evento Medellín").
  label     String?
  // Plan que se regala al canjear este código. Se guarda al crearlo y se
  // aplica tal cual al negocio/profesional que lo canjea — nunca depende
  // del frontend.
  plan      String             @default("team")
  status    CourtesyCodeStatus @default(UNUSED)
  usedAt    DateTime?
  createdAt DateTime           @default(now())

  redeemedByType           ReferralRedeemerType?
  redeemedBusinessId       String?       @unique
  redeemedProfessionalId   String?       @unique
  redeemedBusiness         Business?     @relation(fields: [redeemedBusinessId], references: [id])
  redeemedProfessional     Professional? @relation(fields: [redeemedProfessionalId], references: [id])
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

// Wompi (sandbox) payment attempts for plan checkout
model Payment {
  id                 String        @id @default(cuid())
  reference          String        @unique
  businessId         String?
  professionalId     String?
  plan               String
  amountInCents      Int
  currency           String
  status             PaymentStatus @default(PENDING)
  wompiTransactionId String?
  promoterDiscountApplied Boolean  @default(false)
  referrerCreditApplied   Boolean  @default(false)  // este pago consumió un crédito 20% de referidos
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  business     Business?     @relation(fields: [businessId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
}
