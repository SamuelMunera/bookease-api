generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  BUSINESS_OWNER
  PROFESSIONAL
  ADMIN
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  googleId  String?  @unique
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses          Business[]
  bookings            Booking[]
  professional        Professional?
  passwordResetTokens PasswordResetToken[]
  reviews             Review[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id          String           @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  phone       String?
  category    String
  ownerId     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  logoUrl            String?
  joinCode           String?  @unique
  showRevenueToProf  Boolean  @default(false)
  lat                Float?
  lng                Float?
  owner         User           @relation(fields: [ownerId], references: [id])
  professionals Professional[]
  services      Service[]
  joinRequests  JoinRequest[]
  reviews       Review[]
}

model Professional {
  id         String   @id @default(cuid())
  name       String
  bio        String?
  phone      String?
  specialty  String?
  experience String?
  avatarUrl  String?
  businessId String?
  userId     String?  @unique
  bufferTime Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business           Business?                  @relation(fields: [businessId], references: [id])
  user               User?                      @relation(fields: [userId], references: [id])
  schedules          Schedule[]
  scheduleExceptions ScheduleException[]
  scheduleOverrides  ScheduleOverride[]
  bookings           Booking[]
  services           Service[]
  joinRequests       JoinRequest[]
  serviceConfigs     ProfessionalServiceConfig[]
  photos             ProfessionalPhoto[]
  reviews            Review[]
}

model ProfessionalPhoto {
  id             String   @id @default(cuid())
  professionalId String
  url            String
  caption        String?
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model ProfessionalServiceConfig {
  id             String   @id @default(cuid())
  professionalId String
  serviceId      String
  customDuration Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])

  @@unique([professionalId, serviceId])
}

model JoinRequest {
  id             String            @id @default(cuid())
  professionalId String
  businessId     String
  status         JoinRequestStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  professional   Professional      @relation(fields: [professionalId], references: [id])
  business       Business          @relation(fields: [businessId], references: [id])

  @@unique([professionalId, businessId])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int
  price       Decimal  @db.Decimal(10, 2)
  businessId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business       Business                    @relation(fields: [businessId], references: [id])
  bookings       Booking[]
  professionals  Professional[]
  serviceConfigs ProfessionalServiceConfig[]
}

// Weekly recurring availability per professional
// dayOfWeek: 0=Sunday ... 6=Saturday
model Schedule {
  id             String   @id @default(cuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id])

  @@unique([professionalId, dayOfWeek])
}

// Per-week overrides for the recurring schedule
model ScheduleOverride {
  id             String   @id @default(cuid())
  professionalId String
  weekStart      DateTime @db.Date
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])

  @@unique([professionalId, weekStart, dayOfWeek])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Minimal booking — used by slot engine to exclude occupied time
model Booking {
  id             String        @id @default(cuid())
  professionalId String
  serviceId      String
  clientId       String
  date           DateTime      @db.Date
  startTime      String
  endTime        String
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  client       User         @relation(fields: [clientId], references: [id])
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model Review {
  id             String   @id @default(cuid())
  rating         Int
  comment        String?
  authorId       String
  businessId     String?
  professionalId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  business     Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([authorId, businessId])
  @@unique([authorId, professionalId])
}

model FeedbackReport {
  id          String   @id @default(cuid())
  type        String
  description String
  page        String?
  userEmail   String?
  createdAt   DateTime @default(now())
}

// Blocks a specific date (full day or time range)
model ScheduleException {
  id             String    @id @default(cuid())
  professionalId String
  date           DateTime  @db.Date
  startTime      String?
  endTime        String?
  reason         String?
  createdAt      DateTime  @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])
}
